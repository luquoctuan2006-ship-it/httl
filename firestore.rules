rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidTrip(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.code is string && data.code.size() <= 64 &&
             data.title is string && data.title.size() <= 256;
    }

    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 128;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Admin directory for RBAC lookups
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(userId);
    }

    // Trips collection
    match /trips/{tripId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(tripId) && isValidTrip(incoming());
      allow update: if isSignedIn() && isValidId(tripId) && isValidTrip(incoming());
      allow delete: if isAdmin() && isValidId(tripId);
    }
  }
}
