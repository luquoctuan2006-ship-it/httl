rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Toàn bộ dữ liệu được quản lý và bảo vệ thông qua backend API (Firebase Admin SDK).
    // Client SDK trực tiếp bị chặn hoàn toàn để loại bỏ nguy cơ bị lộ dữ liệu hoặc ghi đè trái phép.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
