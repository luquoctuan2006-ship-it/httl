# Copy this file to .env and replace the placeholder with your Gemini API key.
# Keep this key on the server; do not rename it to a VITE_* variable.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Firebase Web app config. These values are public Firebase identifiers, not service-account secrets.
VITE_FIREBASE_API_KEY=replace_with_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=replace_with_firebase_web_app_id

# Optional path to the Firebase Admin service-account JSON.
# Defaults to secrets/firebase-service-account.json.
FIREBASE_SERVICE_ACCOUNT_PATH="secrets/firebase-service-account.json"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
